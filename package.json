{
  "name": "arcuex",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Programmable financial protection infrastructure for autonomous AI agents — repository foundation",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @arcuex/web dev",
    "build": "pnpm -r --filter './packages/*' typecheck && pnpm --filter @arcuex/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contracts": "cd contracts && forge test",
    "test:all": "pnpm test && pnpm test:contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
