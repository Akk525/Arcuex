# Arc / QuickNode RPC (server-side preferred; public QuickNode Arc testnet endpoint works without a key)
# Override with your QuickNode dashboard endpoint when available.
QUICKNODE_RPC_URL=https://rpc.quicknode.testnet.arc.io

# Public client-side RPC for the dashboard (defaults to Circle public Arc Testnet RPC)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Optional: dedicated QuickNode URL exposed to the browser for dashboard status
# Prefer QUICKNODE_RPC_URL + a Next.js route proxy in production.
NEXT_PUBLIC_QUICKNODE_RPC_URL=https://rpc.quicknode.testnet.arc.io

# Optional WalletConnect / Reown project id (injected wallets work without this)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# QuickNode Streams webhook (not implemented — see docs/integrations/quicknode.md)
# QUICKNODE_STREAMS_WEBHOOK_SECRET=

# Local SQLite ledger for synthetic insurance core (Node runtime API routes)
ARCUE_X_SQLITE_PATH=.data/arcuex.sqlite

# On-chain InsurancePool (unset until deployed on Arc Testnet)
# ARCUE_X_POOL_ADDRESS=
# NEXT_PUBLIC_ARCUE_X_POOL_ADDRESS=
# ARC_TESTNET_RPC_URL=https://rpc.quicknode.testnet.arc.io
# Claims authority is an ops key configured in the contract — never an LLM.

# QuickNode Streams (authenticated webhook) — not the same as RPC
# QUICKNODE_STREAMS_WEBHOOK_SECRET=

# Deploy-only (never commit; never put in Next.js public env)
# DEPLOYER_PRIVATE_KEY=
# CLAIMS_AUTHORITY=
# FEE_RECIPIENT=
# WALLET_PRIVATE_KEY=   # local agent example only
