# Explicit policy source. Hosted production requires a selection; fixture mode has a separate runbook.
ARCUEX_CHAIN_SOURCE=arc-testnet

# Arc / QuickNode RPC (server-side preferred; public QuickNode Arc testnet endpoint works without a key)
# Override with your QuickNode dashboard endpoint when available.
QUICKNODE_RPC_URL=https://rpc.quicknode.testnet.arc.io

# Public client-side RPC for the dashboard (defaults to Circle public Arc Testnet RPC)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Optional: dedicated QuickNode URL exposed to the browser for dashboard status
# Prefer QUICKNODE_RPC_URL + a Next.js route proxy in production.
NEXT_PUBLIC_QUICKNODE_RPC_URL=https://rpc.quicknode.testnet.arc.io

# Optional WalletConnect / Reown project id (injected wallets work without this)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Local SQLite ledger for synthetic insurance core (Node runtime API routes)
ARCUE_X_SQLITE_PATH=.data/arcuex.sqlite

# On-chain InsurancePool (Arc Testnet) — addresses also in docs/deployments/*.json
# ARCUE_X_POOL_ADDRESS=0x6657974EEdF488380251bDD95A7FFfb0D456E49E
# NEXT_PUBLIC_ARCUE_X_POOL_ADDRESS=0x6657974EEdF488380251bDD95A7FFfb0D456E49E
# ARC_TESTNET_RPC_URL=https://rpc.quicknode.testnet.arc.io
# Claims authority is an ops key configured in the contract — never an LLM.

# ClaimsCase HTTP API role tokens (Bearer). Client actor strings cannot escalate privilege.
# Generate long random values for testnet beta; never commit real secrets.
# Each token must be 64 hex characters and distinct from ARCUEX_RATE_LIMIT_SECRET.
# CLAIMS_REVIEWER_API_TOKEN=
# CLAIMS_AUTHORITY_API_TOKEN=
# CLAIMS_SYSTEM_API_TOKEN=
# CLAIMS_ALLOW_SYNTHETIC_SETTLEMENT_PREP=0   # must stay 0/unset in public-beta
# CLAIMS_COOKIE_SECURE=1                    # required in production

# QuickNode Streams (authenticated webhook) — not the same as RPC
# QUICKNODE_STREAMS_WEBHOOK_SECRET=

# --- Railway public-beta / local-test production start (NODE_ENV=production) ---
# ARCUEX_DEPLOYMENT_MODE=public-beta        # or local-test for offline smoke
# ARCUEX_PUBLIC_ORIGIN=https://your-domain.up.railway.app
# ARCUEX_PUBLIC_HOST=your-domain.up.railway.app
# ARCUEX_TLS_SERVER_NAME=your-domain.up.railway.app
# ARCUEX_CHAIN_ID=5042002
# ARCUEX_DATA_DIR=/data
# ARCUE_X_SQLITE_PATH=/data/arcuex.sqlite
# ARCUEX_STORAGE_ID=vol-arcuex-beta-01      # must match /data/.arcuex-volume-id
# ARCUEX_SESSION_EPOCH=launch-2026-11-20    # rotate to revoke all sessions
# ARCUEX_RATE_LIMIT_SECRET=                 # 64 hex chars; HMAC key only, never a proxy auth token
# ARCUEX_ACCEPTANCE_GATE_TOKEN=             # required for public-beta; private host acceptance gate
# Do NOT set ARCUEX_PROXY_TOKEN — Railway edge overwrites X-Real-IP / X-Forwarded-*;
# custom proxy tokens are rejected. Do not place untrusted sibling services on this HTTP port.
# RAILWAY_RUN_UID=0                         # required so the process can write the /data volume
# ARCUEX_SESSION_TTL_SECONDS=28800
# ARCUEX_NONCE_TTL_SECONDS=600

# Deploy / lifecycle (never commit; never put in Next.js public env; never print)
# Forbidden in public-beta process env: DEPLOYER_PRIVATE_KEY, *_PRIVATE_KEY, SEED_PHRASE, MNEMONIC
# DEPLOYER_PRIVATE_KEY=
# CLAIMS_AUTHORITY=
# FEE_RECIPIENT=
# LP_PRIVATE_KEY=
# POLICYHOLDER_PRIVATE_KEY=
# CLAIMS_AUTHORITY_PRIVATE_KEY=   # must control on-chain claimsAuthority; fund with gas
# BENEFICIARY_ADDRESS=
# LIFECYCLE_LP_USE_DEPLOYER=1              # explicit opt-in only
# LIFECYCLE_POLICYHOLDER_USE_DEPLOYER=1    # explicit opt-in only
# WALLET_PRIVATE_KEY=   # local agent example only
